<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDV & Gestão de Loja (Firebase Realtime)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8' }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen pb-20 md:pb-6 font-sans">

    <!-- Status da Conexão Firebase -->
    <div id="status-conexao" class="bg-amber-500 text-slate-900 font-bold text-xs py-1 px-4 text-center">
        ⚡ Conectando ao Firebase Realtime Database...
    </div>

    <!-- Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-30 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-blue-600 rounded-xl text-white">
                    <i class="fa-solid fa-bottle-water text-xl"></i>
                    <i class="fa-solid fa-store text-xl ml-1"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">PDV & Estoque</h1>
                    <p class="text-xs text-slate-400">Sincronizado via Firebase Nuvem</p>
                </div>
            </div>
            <button onclick="abrirModalTroco()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded-lg text-sm flex items-center gap-2 border border-slate-600">
                <i class="fa-solid fa-cash-register text-emerald-400"></i>
                <span class="hidden sm:inline">Ajustar Saldo Inicial</span>
            </button>
        </div>
    </header>

    <!-- Navegação Superior / Mobile Bottom -->
    <nav class="bg-slate-800 border-t border-slate-700 md:border-b md:border-t-0 fixed bottom-0 left-0 right-0 md:sticky md:top-[61px] z-20 shadow-xl">
        <div class="max-w-7xl mx-auto flex justify-around md:justify-start gap-1 p-2">
            <button onclick="mudarAba('vender')" id="nav-vender" class="aba-btn flex-1 md:flex-none px-4 py-2 rounded-lg text-sm font-medium transition flex flex-col md:flex-row items-center justify-center gap-2 bg-blue-600 text-white">
                <i class="fa-solid fa-cart-shopping"></i> Vender (PDV)
            </button>
            <button onclick="mudarAba('produtos')" id="nav-produtos" class="aba-btn flex-1 md:flex-none px-4 py-2 rounded-lg text-sm font-medium transition flex flex-col md:flex-row items-center justify-center gap-2 text-slate-400 hover:bg-slate-700">
                <i class="fa-solid fa-boxes-stacked"></i> Produtos
            </button>
            <button onclick="mudarAba('clientes')" id="nav-clientes" class="aba-btn flex-1 md:flex-none px-4 py-2 rounded-lg text-sm font-medium transition flex flex-col md:flex-row items-center justify-center gap-2 text-slate-400 hover:bg-slate-700">
                <i class="fa-solid fa-users"></i> Clientes
            </button>
            <button onclick="mudarAba('entregas')" id="nav-entregas" class="aba-btn flex-1 md:flex-none px-4 py-2 rounded-lg text-sm font-medium transition flex flex-col md:flex-row items-center justify-center gap-2 text-slate-400 hover:bg-slate-700 relative">
                <i class="fa-solid fa-motorcycle"></i> Entregas
                <span id="badge-entregas" class="hidden absolute top-1 right-2 md:relative md:top-0 md:right-0 bg-amber-500 text-slate-900 font-bold text-xs px-1.5 py-0.5 rounded-full">0</span>
            </button>
            <button onclick="mudarAba('caixa')" id="nav-caixa" class="aba-btn flex-1 md:flex-none px-4 py-2 rounded-lg text-sm font-medium transition flex flex-col md:flex-row items-center justify-center gap-2 text-slate-400 hover:bg-slate-700">
                <i class="fa-solid fa-chart-line"></i> Caixa & Histórico
            </button>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="max-w-7xl mx-auto p-4 md:p-6">

        <!-- ABA VENDER (PDV) -->
        <section id="aba-vender" class="aba-conteudo space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="grid-vendas-produtos"></div>
        </section>

        <!-- ABA PRODUTOS (ESTOQUE) -->
        <section id="aba-produtos" class="aba-conteudo hidden space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-slate-800 p-4 rounded-xl border border-slate-700">
                <div>
                    <h2 class="text-lg font-bold">Gerenciamento de Estoque</h2>
                    <p class="text-xs text-slate-400">Cadastre e ajuste preços ou quantidades na nuvem</p>
                </div>
                <button onclick="abrirModalProduto()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg font-medium text-sm flex items-center gap-2 shadow-lg">
                    <i class="fa-solid fa-plus"></i> Novo Produto
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="grid-estoque-produtos"></div>
        </section>

        <!-- ABA CLIENTES -->
        <section id="aba-clientes" class="aba-conteudo hidden space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-slate-800 p-4 rounded-xl border border-slate-700">
                <div>
                    <h2 class="text-lg font-bold">Cadastro de Clientes</h2>
                    <p class="text-xs text-slate-400">Endereços salvos e sincronizados com a equipe</p>
                </div>
                <button onclick="abrirModalCliente()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg font-medium text-sm flex items-center gap-2">
                    <i class="fa-solid fa-user-plus"></i> Adicionar Cliente
                </button>
            </div>
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400"></i>
                <input type="text" id="busca-cliente-aba" oninput="filtrarClientesAba()" placeholder="Pesquisar por nome, telefone ou rua..." class="w-full pl-10 pr-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 text-sm focus:outline-none focus:border-blue-500">
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="grid-clientes"></div>
        </section>

        <!-- ABA ENTREGAS -->
        <section id="aba-entregas" class="aba-conteudo hidden space-y-6">
            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700">
                <h2 class="text-lg font-bold text-amber-400">Painel do Entregador (Tempo Real)</h2>
                <p class="text-xs text-slate-400">Quando a loja lança uma venda, ela aparece na hora nesta tela para o entregador</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="grid-entregas"></div>
        </section>

        <!-- ABA CAIXA & HISTÓRICO -->
        <section id="aba-caixa" class="aba-conteudo hidden space-y-6">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                <div class="bg-slate-800 p-3.5 rounded-xl border border-slate-700">
                    <span class="text-xs text-slate-400 block">Troco Inicial</span>
                    <span id="c-troco" class="text-lg font-bold text-slate-200">R$ 0,00</span>
                </div>
                <div class="bg-slate-800 p-3.5 rounded-xl border border-slate-700">
                    <span class="text-xs text-slate-400 block">Dinheiro (Gaveta)</span>
                    <span id="c-dinheiro" class="text-lg font-bold text-emerald-400">R$ 0,00</span>
                </div>
                <div class="bg-slate-800 p-3.5 rounded-xl border border-slate-700">
                    <span class="text-xs text-slate-400 block">Cartão</span>
                    <span id="c-cartao" class="text-lg font-bold text-blue-400">R$ 0,00</span>
                </div>
                <div class="bg-slate-800 p-3.5 rounded-xl border border-slate-700">
                    <span class="text-xs text-slate-400 block">PIX</span>
                    <span id="c-pix" class="text-lg font-bold text-purple-400">R$ 0,00</span>
                </div>
                <div class="bg-slate-800 p-3.5 rounded-xl border border-slate-700">
                    <span class="text-xs text-slate-400 block">Taxas Entregador</span>
                    <span id="c-taxas" class="text-lg font-bold text-amber-400">R$ 0,00</span>
                </div>
                <div class="bg-slate-800 p-3.5 rounded-xl border border-slate-700 bg-slate-800/80">
                    <span class="text-xs text-slate-400 block">Total Faturado</span>
                    <span id="c-total" class="text-lg font-bold text-cyan-400">R$ 0,00</span>
                </div>
            </div>

            <div class="flex gap-3 justify-end">
                <button onclick="fecharCaixa()" class="bg-red-600/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/30 px-4 py-2 rounded-lg text-sm font-medium transition">
                    <i class="fa-solid fa-lock"></i> Reiniciar / Fechar Caixa
                </button>
            </div>

            <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-700 font-bold flex justify-between items-center">
                    <span>Histórico de Vendas</span>
                    <span class="text-xs text-slate-400 font-normal">Estornos devolvem o estoque na hora</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-900/50 text-slate-400 text-xs uppercase">
                            <tr>
                                <th class="p-3">Data/Hora</th>
                                <th class="p-3">Produto</th>
                                <th class="p-3">Cliente / Tipo</th>
                                <th class="p-3">Pagamento</th>
                                <th class="p-3">Total</th>
                                <th class="p-3 text-right">Ação</th>
                            </tr>
                        </thead>
                        <tbody id="lista-vendas" class="divide-y divide-slate-700/50"></tbody>
                    </table>
                </div>
            </div>
        </section>

    </main>

    <!-- MODAL FINALIZAR VENDA -->
    <div id="modal-venda" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-800 max-w-lg w-full rounded-2xl border border-slate-700 p-5 space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h3 class="font-bold text-lg">Finalizar Venda</h3>
                <button onclick="fecharModalVenda()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>

            <div class="space-y-2">
                <label class="text-xs text-slate-400 font-semibold uppercase">Cliente (Opcional)</label>
                <input type="text" id="venda-busca-cliente" oninput="filtrarClientesModal()" placeholder="🔍 Digite para buscar cliente salvo..." class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-100">
                <select id="venda-cliente-select" onchange="selecionarClienteSalvo()" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-100">
                    <option value="">-- Cliente Balcão / Não Cadastrado --</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <button type="button" onclick="setTipoEntrega('retirada')" id="btn-retirada" class="py-2.5 rounded-lg text-sm font-semibold border border-blue-500 bg-blue-600/20 text-blue-400">
                    <i class="fa-solid fa-store"></i> Retirada Balcão
                </button>
                <button type="button" onclick="setTipoEntrega('entrega')" id="btn-entrega" class="py-2.5 rounded-lg text-sm font-semibold border border-slate-700 bg-slate-900 text-slate-400">
                    <i class="fa-solid fa-motorcycle"></i> Entrega
                </button>
            </div>

            <div id="campos-entrega" class="hidden space-y-3 p-3 bg-slate-900/60 rounded-xl border border-slate-700">
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="text-xs text-slate-400">Nome do Cliente *</label>
                        <input type="text" id="ent-nome" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400">Taxa do Entregador (R$)</label>
                        <input type="number" step="0.50" id="ent-taxa" oninput="calcularTotalVenda()" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                    </div>
                </div>
                <div>
                    <label class="text-xs text-slate-400">Rua e Bairro (Para o Google Maps) *</label>
                    <input type="text" id="ent-rua-bairro" placeholder="Ex: Rua das Flores, Centro" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
                <div>
                    <label class="text-xs text-slate-400">Nº / Apto / Complemento (Somente para o entregador)</label>
                    <input type="text" id="ent-complemento" placeholder="Ex: Nº 123, Apto 201" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
            </div>

            <div class="flex items-center justify-between bg-slate-900 p-3 rounded-xl border border-slate-700">
                <span class="text-sm font-medium">Quantidade:</span>
                <div class="flex items-center gap-3">
                    <button onclick="alterarQtdVenda(-1)" class="w-8 h-8 bg-slate-800 rounded-lg flex items-center justify-center font-bold text-lg text-slate-300">-</button>
                    <span id="venda-qtd" class="font-bold text-lg w-6 text-center">1</span>
                    <button onclick="alterarQtdVenda(1)" class="w-8 h-8 bg-slate-800 rounded-lg flex items-center justify-center font-bold text-lg text-slate-300">+</button>
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-xs text-slate-400 font-semibold uppercase">Forma de Pagamento</label>
                <select id="venda-pagamento" onchange="alterarFormaPagamento()" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-100">
                    <option value="dinheiro">💵 Dinheiro</option>
                    <option value="pix">📱 PIX</option>
                    <option value="cartao">💳 Cartão</option>
                    <option value="misto">🔀 Misto / Mesclado</option>
                </select>
            </div>

            <div id="campo-misto" class="hidden p-3 bg-slate-900/60 rounded-xl border border-slate-700 space-y-2">
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="text-xs text-slate-400">Valor em Dinheiro (R$)</label>
                        <input type="number" step="0.01" id="misto-dinheiro" oninput="calcularMisto()" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400">Outro (Pix/Cartão)</label>
                        <select id="misto-tipo-outro" class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                            <option value="pix">PIX</option>
                            <option value="cartao">Cartão</option>
                        </select>
                    </div>
                </div>
                <div class="text-xs text-slate-400 flex justify-between">
                    <span>Restante no Outro Pagamento:</span>
                    <span id="misto-restante" class="font-bold text-slate-200">R$ 0,00</span>
                </div>
            </div>

            <div class="border-t border-slate-700 pt-3 flex justify-between items-center">
                <span class="text-slate-400">Total a Pagar:</span>
                <span id="venda-total" class="text-2xl font-black text-emerald-400">R$ 0,00</span>
            </div>

            <button onclick="confirmarVenda()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-lg transition">
                <i class="fa-solid fa-check"></i> Finalizar e Registrar Venda
            </button>
        </div>
    </div>

    <!-- MODAL PRODUTO -->
    <div id="modal-produto" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-800 max-w-md w-full rounded-2xl border border-slate-700 p-5 space-y-4">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h3 class="font-bold text-lg" id="modal-prod-titulo">Adicionar Produto</h3>
                <button onclick="fecharModalProduto()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <input type="hidden" id="prod-id">
            <div class="space-y-3">
                <div>
                    <label class="text-xs text-slate-400">Nome do Produto</label>
                    <input type="text" id="prod-nome" placeholder="Ex: Água Mineral 20L" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-slate-400">Preço (R$)</label>
                        <input type="number" step="0.50" id="prod-preco" placeholder="12.00" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400">Estoque Inicial</label>
                        <input type="number" id="prod-estoque" placeholder="50" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                    </div>
                </div>
                <div>
                    <label class="text-xs text-slate-400">Taxa de Entrega Padrão (R$)</label>
                    <input type="number" step="0.50" id="prod-taxa" placeholder="3.00" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
            </div>
            <button onclick="salvarProduto()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl shadow-lg">Salvar Produto</button>
        </div>
    </div>

    <!-- MODAL CLIENTE -->
    <div id="modal-cliente" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-800 max-w-md w-full rounded-2xl border border-slate-700 p-5 space-y-4">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h3 class="font-bold text-lg">Novo Cliente</h3>
                <button onclick="fecharModalCliente()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <div class="space-y-3">
                <div>
                    <label class="text-xs text-slate-400">Nome do Cliente *</label>
                    <input type="text" id="cli-nome" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
                <div>
                    <label class="text-xs text-slate-400">Telefone / WhatsApp</label>
                    <input type="text" id="cli-tel" placeholder="(21) 99999-9999" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
                <div>
                    <label class="text-xs text-slate-400">Rua e Bairro (Para GPS / Maps) *</label>
                    <input type="text" id="cli-rua-bairro" placeholder="Rua São Paulo, Centro" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
                <div>
                    <label class="text-xs text-slate-400">Nº / Apto / Complemento</label>
                    <input type="text" id="cli-complemento" placeholder="Nº 45, Bloco B" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm">
                </div>
            </div>
            <button onclick="salvarCliente()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl shadow-lg">Salvar Cliente</button>
        </div>
    </div>

    <!-- SDK FIREBASE REALTIME DATABASE -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getDatabase, ref, set, remove, onValue } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

        const firebaseConfig = {
            databaseURL: "https://entregas-732b8-default-rtdb.firebaseio.com/"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        window.produtos = [];
        window.clientes = [];
        window.vendas = [];
        window.trocoInicial = 0.00;

        // OUVINTES EM TEMPO REAL (REALTIME DATABASE)
        onValue(ref(db, 'produtos'), (snapshot) => {
            const data = snapshot.val();
            window.produtos = data ? Object.values(data) : [
                { id: 1, nome: 'Água Galão 20L', preco: 14.00, estoque: 45, taxa: 3.00 },
                { id: 2, nome: 'Água Garrafa 500ml (Fardo c/12)', preco: 18.00, estoque: 20, taxa: 2.50 },
                { id: 3, nome: 'Gás de Cozinha P13', preco: 95.00, estoque: 10, taxa: 5.00 }
            ];
            renderizarTudo();
            atualizarStatusConexao();
        });

        onValue(ref(db, 'clientes'), (snapshot) => {
            const data = snapshot.val();
            window.clientes = data ? Object.values(data) : [];
            renderizarTudo();
        });

        onValue(ref(db, 'vendas'), (snapshot) => {
            const data = snapshot.val();
            window.vendas = data ? Object.values(data).sort((a,b) => b.id - a.id) : [];
            renderizarTudo();
        });

        onValue(ref(db, 'troco'), (snapshot) => {
            window.trocoInicial = snapshot.val() || 0;
            renderizarCaixa();
        });

        function atualizarStatusConexao() {
            const st = document.getElementById('status-conexao');
            st.className = "bg-emerald-600 text-white font-bold text-xs py-1 px-4 text-center";
            st.innerHTML = "🟢 Sincronizado em Tempo Real com o Firebase Realtime!";
        }

        // FUNÇÕES DE SALVAR NA NUVEM
        window.dbSaveProduto = async (prod) => {
            await set(ref(db, 'produtos/' + prod.id), prod);
        };
        window.dbDeleteProduto = async (id) => {
            await remove(ref(db, 'produtos/' + id));
        };

        window.dbSaveCliente = async (cli) => {
            await set(ref(db, 'clientes/' + cli.id), cli);
        };
        window.dbDeleteCliente = async (id) => {
            await remove(ref(db, 'clientes/' + id));
        };

        window.dbSaveVenda = async (venda) => {
            await set(ref(db, 'vendas/' + venda.id), venda);
        };
        window.dbDeleteVenda = async (id) => {
            await remove(ref(db, 'vendas/' + id));
        };

        window.dbSaveTroco = async (val) => {
            await set(ref(db, 'troco'), val);
        };
    </script>

    <script>
        let produtoSelecionado = null;
        let qtdVenda = 1;
        let tipoEntrega = 'retirada';

        function mudarAba(aba) {
            document.querySelectorAll('.aba-conteudo').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.aba-btn').forEach(el => {
                el.classList.remove('bg-blue-600', 'text-white');
                el.classList.add('text-slate-400');
            });

            document.getElementById(`aba-${aba}`).classList.remove('hidden');
            const btn = document.getElementById(`nav-${aba}`);
            btn.classList.add('bg-blue-600', 'text-white');
            btn.classList.remove('text-slate-400');

            renderizarTudo();
        }

        function renderizarTudo() {
            renderizarVendasPDV();
            renderizarEstoque();
            renderizarClientes();
            renderizarEntregas();
            renderizarCaixa();
        }

        function renderizarVendasPDV() {
            const grid = document.getElementById('grid-vendas-produtos');
            if(!grid) return;
            grid.innerHTML = (window.produtos || []).map(p => `
                <div class="bg-slate-800 rounded-2xl p-4 border border-slate-700 flex flex-col justify-between hover:border-slate-600 transition shadow-lg">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-xs font-bold px-2 py-1 bg-slate-700 text-blue-400 rounded-md">ID #${p.id}</span>
                            <span class="text-xs font-semibold px-2 py-1 ${p.estoque > 5 ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'} rounded-md">
                                ${p.estoque} em estoque
                            </span>
                        </div>
                        <h3 class="font-bold text-lg text-slate-100">${p.nome}</h3>
                        <p class="text-2xl font-black text-emerald-400 mt-1">R$ ${Number(p.preco).toFixed(2)}</p>
                    </div>
                    <button onclick="iniciarVenda('${p.id}')" ${p.estoque <= 0 ? 'disabled' : ''} class="mt-4 w-full py-2.5 bg-blue-600 hover:bg-blue-500 disabled:bg-slate-700 disabled:text-slate-500 text-white font-bold rounded-xl flex items-center justify-center gap-2 transition">
                        <i class="fa-solid fa-cart-plus"></i> ${p.estoque > 0 ? 'Vender' : 'Sem Estoque'}
                    </button>
                </div>
            `).join('');
        }

        function iniciarVenda(id) {
            produtoSelecionado = window.produtos.find(p => p.id == id);
            qtdVenda = 1;
            tipoEntrega = 'retirada';
            document.getElementById('venda-qtd').innerText = '1';
            document.getElementById('venda-busca-cliente').value = '';
            document.getElementById('ent-nome').value = '';
            document.getElementById('ent-taxa').value = produtoSelecionado.taxa || 0;
            document.getElementById('ent-rua-bairro').value = '';
            document.getElementById('ent-complemento').value = '';

            carregarSelectClientes();
            setTipoEntrega('retirada');
            alterarFormaPagamento();
            document.getElementById('modal-venda').classList.remove('hidden');
        }

        function carregarSelectClientes(filtro = '') {
            const select = document.getElementById('venda-cliente-select');
            const lista = filtro ? window.clientes.filter(c => c.nome.toLowerCase().includes(filtro.toLowerCase()) || c.tel.includes(filtro)) : window.clientes;
            
            select.innerHTML = `<option value="">-- Cliente Balcão / Não Cadastrado --</option>` +
                lista.map(c => `<option value="${c.id}">${c.nome} (${c.tel || 'S/ Tel'})</option>`).join('');
        }

        function filtrarClientesModal() {
            const txt = document.getElementById('venda-busca-cliente').value;
            carregarSelectClientes(txt);
        }

        function selecionarClienteSalvo() {
            const id = document.getElementById('venda-cliente-select').value;
            if (!id) return;
            const cli = window.clientes.find(c => c.id == id);
            if (cli) {
                setTipoEntrega('entrega');
                document.getElementById('ent-nome').value = cli.nome;
                document.getElementById('ent-rua-bairro').value = cli.ruaBairro;
                document.getElementById('ent-complemento').value = cli.complemento;
            }
        }

        function setTipoEntrega(tipo) {
            tipoEntrega = tipo;
            const btnR = document.getElementById('btn-retirada');
            const btnE = document.getElementById('btn-entrega');
            const campos = document.getElementById('campos-entrega');

            if (tipo === 'entrega') {
                btnE.className = "py-2.5 rounded-lg text-sm font-semibold border border-blue-500 bg-blue-600/20 text-blue-400";
                btnR.className = "py-2.5 rounded-lg text-sm font-semibold border border-slate-700 bg-slate-900 text-slate-400";
                campos.classList.remove('hidden');
            } else {
                btnR.className = "py-2.5 rounded-lg text-sm font-semibold border border-blue-500 bg-blue-600/20 text-blue-400";
                btnE.className = "py-2.5 rounded-lg text-sm font-semibold border border-slate-700 bg-slate-900 text-slate-400";
                campos.classList.add('hidden');
            }
            calcularTotalVenda();
        }

        function alterarQtdVenda(delta) {
            if (qtdVenda + delta >= 1 && qtdVenda + delta <= produtoSelecionado.estoque) {
                qtdVenda += delta;
                document.getElementById('venda-qtd').innerText = qtdVenda;
                calcularTotalVenda();
            }
        }

        function calcularTotalVenda() {
            if (!produtoSelecionado) return;
            let subtotal = Number(produtoSelecionado.preco) * qtdVenda;
            let taxa = tipoEntrega === 'entrega' ? (parseFloat(document.getElementById('ent-taxa').value) || 0) : 0;
            let total = subtotal + taxa;
            document.getElementById('venda-total').innerText = `R$ ${total.toFixed(2)}`;
            calcularMisto();
        }

        function alterarFormaPagamento() {
            const pag = document.getElementById('venda-pagamento').value;
            const divMisto = document.getElementById('campo-misto');
            if (pag === 'misto') {
                divMisto.classList.remove('hidden');
                calcularMisto();
            } else {
                divMisto.classList.add('hidden');
            }
        }

        function calcularMisto() {
            if (!produtoSelecionado) return;
            let subtotal = Number(produtoSelecionado.preco) * qtdVenda;
            let taxa = tipoEntrega === 'entrega' ? (parseFloat(document.getElementById('ent-taxa').value) || 0) : 0;
            let total = subtotal + taxa;

            let din = parseFloat(document.getElementById('misto-dinheiro').value) || 0;
            let restante = Math.max(0, total - din);
            document.getElementById('misto-restante').innerText = `R$ ${restante.toFixed(2)}`;
        }

        function fecharModalVenda() {
            document.getElementById('modal-venda').classList.add('hidden');
        }

        async function confirmarVenda() {
            if (produtoSelecionado.estoque < qtdVenda) {
                alert('Estoque insuficiente!');
                return;
            }

            let taxa = tipoEntrega === 'entrega' ? (parseFloat(document.getElementById('ent-taxa').value) || 0) : 0;
            let total = (Number(produtoSelecionado.preco) * qtdVenda) + taxa;
            let pag = document.getElementById('venda-pagamento').value;

            let detalhePag = {};
            if (pag === 'misto') {
                let din = parseFloat(document.getElementById('misto-dinheiro').value) || 0;
                let outroVal = Math.max(0, total - din);
                let outroTipo = document.getElementById('misto-tipo-outro').value;
                detalhePag = { tipo: 'misto', dinheiro: din, outroTipo: outroTipo, outroValor: outroVal };
            } else {
                detalhePag = { tipo: pag, valor: total };
            }

            let clienteNome = tipoEntrega === 'entrega' ? document.getElementById('ent-nome').value : 'Balcão';
            let ruaBairro = tipoEntrega === 'entrega' ? document.getElementById('ent-rua-bairro').value : '';
            let complemento = tipoEntrega === 'entrega' ? document.getElementById('ent-complemento').value : '';

            // Abater estoque na nuvem
            produtoSelecionado.estoque = Number(produtoSelecionado.estoque) - Number(qtdVenda);
            await window.dbSaveProduto(produtoSelecionado);

            // Criar venda na nuvem
            const venda = {
                id: Date.now(),
                data: new Date().toLocaleString('pt-BR'),
                produtoId: produtoSelecionado.id,
                produtoNome: produtoSelecionado.nome,
                qtd: qtdVenda,
                total: total,
                taxaEntregador: taxa,
                tipoEntrega: tipoEntrega,
                cliente: clienteNome,
                ruaBairro: ruaBairro,
                complemento: complemento,
                pagamento: detalhePag,
                statusEntrega: tipoEntrega === 'entrega' ? 'pendente' : 'concluida'
            };

            await window.dbSaveVenda(venda);
            fecharModalVenda();
        }

        // ESTOQUE
        function renderizarEstoque() {
            const grid = document.getElementById('grid-estoque-produtos');
            if(!grid) return;
            grid.innerHTML = (window.produtos || []).map(p => `
                <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 flex justify-between items-center">
                    <div>
                        <h4 class="font-bold text-slate-100">${p.nome}</h4>
                        <p class="text-xs text-slate-400">Preço: R$ ${Number(p.preco).toFixed(2)} | Taxa: R$ ${Number(p.taxa||0).toFixed(2)}</p>
                        <p class="text-sm font-bold text-emerald-400 mt-1">Estoque: ${p.estoque} un</p>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="editarProduto('${p.id}')" class="p-2 bg-slate-700 hover:bg-slate-600 text-blue-400 rounded-lg"><i class="fa-solid fa-pen"></i></button>
                        <button onclick="excluirProduto('${p.id}')" class="p-2 bg-slate-700 hover:bg-slate-600 text-red-400 rounded-lg"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            `).join('');
        }

        function abrirModalProduto() {
            document.getElementById('prod-id').value = '';
            document.getElementById('prod-nome').value = '';
            document.getElementById('prod-preco').value = '';
            document.getElementById('prod-estoque').value = '';
            document.getElementById('prod-taxa').value = '';
            document.getElementById('modal-prod-titulo').innerText = 'Adicionar Produto';
            document.getElementById('modal-produto').classList.remove('hidden');
        }

        function editarProduto(id) {
            const p = window.produtos.find(x => x.id == id);
            if (!p) return;
            document.getElementById('prod-id').value = p.id;
            document.getElementById('prod-nome').value = p.nome;
            document.getElementById('prod-preco').value = p.preco;
            document.getElementById('prod-estoque').value = p.estoque;
            document.getElementById('prod-taxa').value = p.taxa || 0;
            document.getElementById('modal-prod-titulo').innerText = 'Editar Produto';
            document.getElementById('modal-produto').classList.remove('hidden');
        }

        function fecharModalProduto() {
            document.getElementById('modal-produto').classList.add('hidden');
        }

        async function salvarProduto() {
            const id = document.getElementById('prod-id').value || Date.now().toString();
            const nome = document.getElementById('prod-nome').value;
            const preco = parseFloat(document.getElementById('prod-preco').value) || 0;
            const estoque = parseInt(document.getElementById('prod-estoque').value) || 0;
            const taxa = parseFloat(document.getElementById('prod-taxa').value) || 0;

            if (!nome) return alert('Informe o nome do produto');

            await window.dbSaveProduto({ id, nome, preco, estoque, taxa });
            fecharModalProduto();
        }

        async function excluirProduto(id) {
            if (confirm('Excluir este produto do estoque?')) {
                await window.dbDeleteProduto(id);
            }
        }

        // CLIENTES
        function renderizarClientes() {
            const grid = document.getElementById('grid-clientes');
            if(!grid) return;
            const txt = document.getElementById('busca-cliente-aba') ? document.getElementById('busca-cliente-aba').value.toLowerCase() : '';
            
            const lista = txt ? window.clientes.filter(c => c.nome.toLowerCase().includes(txt) || c.tel.includes(txt) || c.ruaBairro.toLowerCase().includes(txt)) : window.clientes;

            grid.innerHTML = lista.map(c => `
                <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 space-y-2 relative">
                    <div class="flex justify-between items-start">
                        <h4 class="font-bold text-slate-100">${c.nome}</h4>
                        <button onclick="excluirCliente('${c.id}')" class="text-xs bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white px-2 py-1 rounded transition">
                            <i class="fa-solid fa-trash"></i> Excluir
                        </button>
                    </div>
                    <p class="text-xs text-slate-400"><i class="fa-solid fa-phone text-blue-400"></i> ${c.tel || 'Não informado'}</p>
                    <p class="text-xs text-slate-300"><i class="fa-solid fa-location-dot text-amber-400"></i> <strong>Rua/Bairro:</strong> ${c.ruaBairro}</p>
                    ${c.complemento ? `<p class="text-xs text-slate-400"><strong>Comp:</strong> ${c.complemento}</p>` : ''}
                </div>
            `).join('');
        }

        function filtrarClientesAba() {
            renderizarClientes();
        }

        function abrirModalCliente() {
            document.getElementById('cli-nome').value = '';
            document.getElementById('cli-tel').value = '';
            document.getElementById('cli-rua-bairro').value = '';
            document.getElementById('cli-complemento').value = '';
            document.getElementById('modal-cliente').classList.remove('hidden');
        }

        function fecharModalCliente() {
            document.getElementById('modal-cliente').classList.add('hidden');
        }

        async function salvarCliente() {
            const nome = document.getElementById('cli-nome').value;
            const tel = document.getElementById('cli-tel').value;
            const ruaBairro = document.getElementById('cli-rua-bairro').value;
            const complemento = document.getElementById('cli-complemento').value;

            if (!nome || !ruaBairro) return alert('Preencha o Nome e a Rua/Bairro para GPS.');

            const id = Date.now().toString();
            await window.dbSaveCliente({ id, nome, tel, ruaBairro, complemento });
            fecharModalCliente();
        }

        async function excluirCliente(id) {
            if (confirm('Tem certeza que deseja apagar este cliente?')) {
                await window.dbDeleteCliente(id);
            }
        }

        // ENTREGAS
        function renderizarEntregas() {
            const grid = document.getElementById('grid-entregas');
            if(!grid) return;
            const pendentes = (window.vendas || []).filter(v => v.tipoEntrega === 'entrega' && v.statusEntrega === 'pendente');
            
            document.getElementById('badge-entregas').innerText = pendentes.length;
            document.getElementById('badge-entregas').classList.toggle('hidden', pendentes.length === 0);

            if (pendentes.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-8 text-slate-500">Nenhuma entrega pendente no momento.</div>`;
                return;
            }

            grid.innerHTML = pendentes.map(v => {
                const urlMaps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(v.ruaBairro)}`;
                
                return `
                    <div class="bg-slate-800 p-4 rounded-xl border border-amber-500/30 space-y-3">
                        <div class="flex justify-between items-start">
                            <span class="text-xs bg-amber-500/20 text-amber-400 font-bold px-2 py-0.5 rounded">Entrega Pendente</span>
                            <span class="text-xs text-slate-400">${v.data.split(' ')[1]}</span>
                        </div>
                        <div>
                            <h4 class="font-bold text-lg text-slate-100">${v.cliente}</h4>
                            <p class="text-sm text-slate-300"><strong>Pedido:</strong> ${v.qtd}x ${v.produtoNome}</p>
                            <p class="text-xs text-slate-400 mt-1"><strong>Maps:</strong> ${v.ruaBairro}</p>
                            ${v.complemento ? `<p class="text-xs text-amber-300"><strong>Comp/Nº:</strong> ${v.complemento}</p>` : ''}
                        </div>
                        <div class="pt-2 border-t border-slate-700 flex flex-col gap-2">
                            <a href="${urlMaps}" target="_blank" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg text-center text-sm flex items-center justify-center gap-2">
                                <i class="fa-solid fa-map-location-dot"></i> Abrir Rota Google Maps
                            </a>
                            <button onclick="concluirEntrega('${v.id}')" class="w-full py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-lg">
                                Concluir Entrega
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function concluirEntrega(id) {
            const v = window.vendas.find(x => x.id == id);
            if (v) {
                v.statusEntrega = 'concluida';
                await window.dbSaveVenda(v);
            }
        }

        // CAIXA
        function renderizarCaixa() {
            let din = 0, cartao = 0, pix = 0, taxas = 0, total = 0;

            (window.vendas || []).forEach(v => {
                total += Number(v.total);
                taxas += Number(v.taxaEntregador || 0);

                if (v.pagamento.tipo === 'dinheiro') din += Number(v.total);
                else if (v.pagamento.tipo === 'cartao') cartao += Number(v.total);
                else if (v.pagamento.tipo === 'pix') pix += Number(v.total);
                else if (v.pagamento.tipo === 'misto') {
                    din += Number(v.pagamento.dinheiro);
                    if (v.pagamento.outroTipo === 'cartao') cartao += Number(v.pagamento.outroValor);
                    if (v.pagamento.outroTipo === 'pix') pix += Number(v.pagamento.outroValor);
                }
            });

            if(document.getElementById('c-troco')) {
                document.getElementById('c-troco').innerText = `R$ ${window.trocoInicial.toFixed(2)}`;
                document.getElementById('c-dinheiro').innerText = `R$ ${(din + window.trocoInicial).toFixed(2)}`;
                document.getElementById('c-cartao').innerText = `R$ ${cartao.toFixed(2)}`;
                document.getElementById('c-pix').innerText = `R$ ${pix.toFixed(2)}`;
                document.getElementById('c-taxas').innerText = `R$ ${taxas.toFixed(2)}`;
                document.getElementById('c-total').innerText = `R$ ${total.toFixed(2)}`;
            }

            const tbody = document.getElementById('lista-vendas');
            if(!tbody) return;
            tbody.innerHTML = (window.vendas || []).map(v => `
                <tr class="hover:bg-slate-700/30">
                    <td class="p-3 text-xs text-slate-400">${v.data}</td>
                    <td class="p-3 font-semibold">${v.qtd}x ${v.produtoNome}</td>
                    <td class="p-3 text-xs">${v.cliente} (${v.tipoEntrega})</td>
                    <td class="p-3 text-xs uppercase font-bold text-blue-400">${v.pagamento.tipo}</td>
                    <td class="p-3 font-bold text-emerald-400">R$ ${Number(v.total).toFixed(2)}</td>
                    <td class="p-3 text-right">
                        <button onclick="cancelarVenda('${v.id}')" class="text-xs bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white px-2 py-1 rounded transition">
                            🚫 Cancelar / Estornar
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        async function abrirModalTroco() {
            let val = prompt('Informe o Saldo Inicial / Troco do Caixa (R$):', window.trocoInicial);
            if (val !== null) {
                await window.dbSaveTroco(parseFloat(val) || 0);
            }
        }

        async function fecharCaixa() {
            if (confirm('Deseja apagar todo o histórico do caixa e reiniciar?')) {
                for (let v of window.vendas) {
                    await window.dbDeleteVenda(v.id);
                }
                await window.dbSaveTroco(0);
            }
        }

        async function cancelarVenda(id) {
            const v = window.vendas.find(x => x.id == id);
            if (!v) return;

            if (confirm(`Cancelar venda de ${v.qtd}x ${v.produtoNome}? O estoque será devolvido na nuvem.`)) {
                const p = window.produtos.find(x => x.id == v.produtoId);
                if (p) {
                    p.estoque = Number(p.estoque) + Number(v.qtd);
                    await window.dbSaveProduto(p);
                }
                await window.dbDeleteVenda(id);
            }
        }
    </script>
</body>
</html>
